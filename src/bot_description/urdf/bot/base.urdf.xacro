<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
   <xacro:include filename="$(find bot_description)/urdf/bot/common_inertia.xacro" />
    <xacro:macro name="base_xacro" params="length width depth wheel_radius x_offset">
     <link name="base_footprint" />

        <joint name="base_joint" type="fixed">
            <parent link="base_footprint" />
            <child link="base_link" />
            <origin xyz="0.0 0.0 ${length/2.0+wheel_radius-0.001}" rpy="0 0 0" />
        </joint>

        <link name="base_link">
            <visual>
                <origin xyz="${x_offset} 0 0.0" rpy="0 0 0" />
                <geometry>
                    <box size="${depth} ${width} ${length}" />
                </geometry>
                <material name="blue">
                    <color rgba="0.1 0.1 1.0 0.5"/>
                </material>
            </visual>
            <collision>
                <origin xyz="${x_offset} 0 0.0" rpy="0 0 0" />
                <geometry>
                    <box size="${depth} ${width} ${length}" />
                </geometry>
                <material name="blue">
                    <color rgba="0.1 0.1 1.0 0.5"/>
                </material>
            </collision>
            <inertial>
                <origin xyz="${x_offset} 0 0.0" rpy="0 0 0" />
                <mass value="5.0" />
                <inertia ixx="${(5.0/12.0) * (width*width + length*length)}" ixy="0.0" ixz="0.0" 
                         iyy="${(5.0/12.0) * (depth*depth + length*length)}" iyz="0.0" 
                         izz="${(5.0/12.0) * (depth*depth + width*width)}" />
            </inertial>
        </link>

    </xacro:macro>

</robot>
