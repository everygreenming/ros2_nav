        <newparam sid="Scratched_black_metal-normal-sampler">
          <sampler2D>
            <source>Scratched_black_metal-normal-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="standard">
          <phong>
            <emission>
              <color sid="emission">0   0   0   1</color>
            </emission>
            <diffuse>
              <texture texture="Scratched_black_metal-diffuse-sampler" texcoord="CHANNEL0" />
            </diffuse>
            <shininess>
              <float sid="shininess">0</float>
            </shininess>
            <transparency>
              <float sid="transparency">1</float>
            </transparency>
            <bump>
              <texture texture="Scratched_black_metal-normal-sampler" texcoord="CHANNEL0" />
            </bump>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
