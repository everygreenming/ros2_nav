    <effect id="Scratched_black_metal-fx" name="Scratched_black_metal">
      <profile_COMMON>
        <newparam sid="Scratched_black_metal-diffuse-surface">
          <surface type="2D">
            <init_from>Scratched_black_metal-diffuse-image</init_from>
          </surface>
        </newparam>
        <newparam sid="Scratched_black_metal-diffuse-sampler">
          <sampler2D>
            <source>Scratched_black_metal-diffuse-surface</source>
