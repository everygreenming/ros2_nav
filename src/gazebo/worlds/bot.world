<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <track_visual>
          <name>bot</name> 
          <static>true</static>
          <use_model_frame>true</use_model_frame>
          <xyz>-1.8 0 3.0</xyz> 
          <inherit_orientation>true</inherit_orientation>
        </track_visual>
      </camera>
    </gui>

    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://bot_map</uri>
    </include>

    <model name="cone_point_2">
      <static>true</static>
      <pose>9.3 2.5 0.05 0 0 0</pose>
      <link name="link">
        <collision name="box_collision">
          <pose>0 0 0.3 0 0 0</pose>
          <geometry>
            <box>
              <size>0.48 0.48 0.5</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <scale>10 10 6</scale>
              <uri>model://construction_cone/meshes/construction_cone.dae</uri>
            </mesh>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Blue</name>
            </script>
          </material>
        </visual>
      </link>
    </model>


  <model name="blue_box_baffle">
      <static>true</static> 
      
      <pose>12.37 2.5 0.25 0 0 0</pose> 

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.5 0.05 0.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.5 0.05 0.5</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Blue</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <name>traffic_light_pillar</name>
      <uri>model://city_traffic_light</uri>
      <pose>12.5 1.2 0.05 0 0 0</pose>
    </include>
  </world>
</sdf>