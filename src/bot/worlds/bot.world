<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://bot_map</uri>
    </include>

    <model name="cone_point_2">
      <static>true</static>
      <pose>9.3 2.5 0 0 0 0</pose>
      <link name="link">
        <!-- 1. 方形底座物理碰撞体（宽35cm，高60cm，容错雷达高度，使得雷达一定能扫出方形轮廓，且物理上能够阻挡小车） -->
        <collision name="box_collision">
          <pose>0 0 0.3 0 0 0</pose>
          <geometry>
            <box>
              <size>0.35 0.35 0.6</size>
            </box>
          </geometry>
        </collision>
        <!-- 2. 视觉外观（依然加载原本好看的锥桶三维模型） -->
        <visual name="visual">
          <geometry>
            <mesh>
              <scale>10 10 10</scale>
              <uri>model://construction_cone/meshes/construction_cone.dae</uri>
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>


  <model name="blue_box_baffle">
      <static>true</static> 
      
      <pose>12.37 2.5 0.25 0 0 0</pose> 

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.5 0.05 0.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.5 0.05 0.5</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Blue</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

  <model name="traffic_light_pillar">
      <static>true</static>
      
      <!-- 向外移动一点(X变小为11.5，Y变小为1.0以远离y=2.5的障碍物)，并且Z轴下移为0 -->
      <pose>11.5 1.0 0 0 0 0</pose> 
      
      <link name="link">
        <collision name="collision">
          <!-- 放宽碰撞体，防止模型太大卡住小车。如果不需要碰撞也可以整段删掉 -->
          <geometry><cylinder><radius>0.4</radius><length>2.0</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <mesh>
              <!-- 使用Gazebo标准模型路径 -->
              <uri>model://city_traffic_light/meshes/city_traffic_light.glb</uri>
              <!-- 如果模型过大或过小，可以取消注释并修改下方缩放比例 -->
              <!-- <scale>1 1 1</scale> -->
            </mesh>
          </geometry>
        </visual>
      </link>
    </model>
  </world>
</sdf>