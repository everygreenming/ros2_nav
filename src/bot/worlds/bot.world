<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <!-- 让 Gazebo 视角跟随小车背后上方 -->
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <track_visual>
          <name>fishbot</name> <!-- 追踪的小车实体名称 -->
          <static>true</static>
          <use_model_frame>true</use_model_frame>
          <xyz>-1.8 0 0.9</xyz> <!-- 相机在小车局部坐标系下的相对位置：后方1.8m，上方0.9m -->
          <inherit_orientation>true</inherit_orientation> <!-- 继承旋转朝向，随小车转弯 -->
        </track_visual>
      </camera>
    </gui>

    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://bot_map</uri>
    </include>

    <model name="cone_point_2">
      <static>true</static>
      <pose>9.3 2.5 0.05 0 0 0</pose>
      <link name="link">
        <!-- 1. 方形底座物理碰撞体（宽35cm，高60cm，容错雷达高度，使得雷达一定能扫出方形轮廓，且物理上能够阻挡小车） -->
        <collision name="box_collision">
          <pose>0 0 0.3 0 0 0</pose>
          <geometry>
            <box>
              <size>0.35 0.35 0.5</size>
            </box>
          </geometry>
        </collision>
        <!-- 2. 视觉外观（依然加载原本好看的锥桶三维模型） -->
        <visual name="visual">
          <geometry>
            <mesh>
              <scale>10 10 6</scale>
              <uri>model://construction_cone/meshes/construction_cone.dae</uri>
            </mesh>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Blue</name>
            </script>
          </material>
        </visual>
      </link>
    </model>


  <model name="blue_box_baffle">
      <static>true</static> 
      
      <pose>12.37 2.5 0.25 0 0 0</pose> 

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.5 0.05 0.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.5 0.05 0.5</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Blue</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <name>traffic_light_pillar</name>
      <uri>model://city_traffic_light</uri>
      <pose>12.5 1.2 0.05 0 0 0</pose>
    </include>
  </world>
</sdf>