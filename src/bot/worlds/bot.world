<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://bot_map</uri>
    </include>

   <include>
      <uri>model://construction_cone</uri>
      <name>cone_point_2</name>
      <pose>9.3 2.685 0 0 0 0</pose> 
    </include>


  <model name="blue_box_baffle">
      <static>true</static> 
      
      <pose>12.37 2.5 0.25 0 0 0</pose> 

      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.5 0.05 0.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.5 0.05 0.5</size>
            </box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Blue</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

  <model name="traffic_light_pillar">
      <static>true</static>
      
      <pose>12.07 1.42 0.4 0 0 0</pose> 
      
      <link name="link">
        <collision name="collision">
          <geometry><cylinder><radius>0.05</radius><length>0.8</length></cylinder></geometry>
        </collision>
        <visual name="base_visual">
          <geometry><cylinder><radius>0.05</radius><length>0.8</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient></material> 
        </visual>
        
        <visual name="light_visual">
          <pose>0 0 0.35 0 0 0</pose>
          <geometry><cylinder><radius>0.055</radius><length>0.1</length></cylinder></geometry>
          <material><ambient>1.0 0.0 0.0 1</ambient></material> 
        </visual>
      </link>
    </model>
  </world>
</sdf>